from django.core.mail import send_mail
from django.conf import settings
import logging

logger = logging.getLogger(__name__)

def send_appointment_email(appointment, action_type):
    """
    Fonction d'envoi d'email améliorée avec logging détaillé
    """
    try:
        logger.info(f"Début de la procédure d'envoi d'email pour le rendez-vous {appointment.id}")
        logger.info(f"Type d'action: {action_type}")
        logger.info(f"Email destinataire: {appointment.user.email}")
        
        # Vérification des paramètres de configuration email
        logger.info("Vérification de la configuration email:")
        logger.info(f"EMAIL_HOST: {settings.EMAIL_HOST}")
        logger.info(f"EMAIL_PORT: {settings.EMAIL_PORT}")
        logger.info(f"EMAIL_USE_TLS: {settings.EMAIL_USE_TLS}")
        logger.info(f"DEFAULT_FROM_EMAIL: {settings.DEFAULT_FROM_EMAIL}")
        
        subject_map = {
            'create': 'Nouveau rendez-vous confirmé',
            'cancel': 'Annulation de rendez-vous',
            'update': 'Modification de rendez-vous'
        }
        
        subject = subject_map[action_type]
        logger.info(f"Sujet de l'email: {subject}")
        
        formatted_date = appointment.date.strftime('%d/%m/%Y à %H:%M')
        message = f"""
        Cher(e) {appointment.user.username},
        
        {subject_map[action_type]} pour la date du {formatted_date}.
        
        Description: {appointment.description}
        
        Cordialement,
        L'équipe 5sursync
        """
        
        logger.info("Tentative d'envoi de l'email...")
        send_mail(
            subject=subject,
            message=message,
            from_email=settings.DEFAULT_FROM_EMAIL,
            recipient_list=[appointment.user.email],
            fail_silently=False,
        )
        logger.info(f"Email envoyé avec succès pour le rendez-vous {appointment.id}")
        return True
        
    except ConnectionRefusedError as e:
        logger.error(f"Erreur de connexion au serveur SMTP: {str(e)}")
        logger.error("Vérifiez que le serveur SMTP est accessible et que le port est correct")
        return False
        
    except TimeoutError as e:
        logger.error(f"Timeout lors de la connexion au serveur SMTP: {str(e)}")
        logger.error("Vérifiez que le serveur SMTP répond et que le pare-feu autorise la connexion")
        return False
        
    except Exception as e:
        logger.error(f"Erreur inattendue lors de l'envoi de l'email: {str(e)}")
        logger.exception("Détails de l'erreur:")
        return False

# Fonction de test de la configuration email
def test_email_configuration():
    """
    Fonction de test de la configuration email
    """
    try:
        logger.info("Test de la configuration email")
        test_subject = "Test de configuration email"
        test_message = "Ceci est un message de test pour vérifier la configuration email."
        
        send_mail(
            subject=test_subject,
            message=test_message,
            from_email=settings.DEFAULT_FROM_EMAIL,
            recipient_list=[settings.EMAIL_HOST_USER],
            fail_silently=False,
        )
        logger.info("Test email envoyé avec succès")
        return True
    except Exception as e:
        logger.error(f"Échec du test email: {str(e)}")
        logger.exception("Détails de l'erreur du test:")
        return False